   "en_pantalla": "Pancarta enorme colgando del techo",
   "cara": "(sin personaje)",
   "camara": "G"
  },
  {
   "n": 37,
   "inicio": 57.06,
   "fin": 58.32,
   "texto": "TESS, I MEAN IT.",
