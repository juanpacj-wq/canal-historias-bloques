  {
   "n": 2,
   "inicio": 2.36,
   "fin": 4.8,
   "texto": "The other six days, only the truth comes out.",
   "escenario": "Pueblo de día",
   "en_pantalla": "Vecino se tapa la boca; igual se le escapa un globo de texto",
   "cara": "Pánico",
   "camara": "C"
  },
  {
   "n": 3,
   "inicio": 4.8,
   "fin": 7.3,
   "texto": "On Monday my teacher said we're her least favorite class.",
   "escenario": "Colegio, salón",
