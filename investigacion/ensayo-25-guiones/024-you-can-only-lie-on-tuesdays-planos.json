   "en_pantalla": "Calendario: martes en rojo, parpadeando",
   "cara": "(sin personaje)",
   "camara": "C"
  },
  {
   "n": 29,
   "inicio": 44.94,
   "fin": 46.34,
   "texto": "I tried to make a Tuesday count.",
