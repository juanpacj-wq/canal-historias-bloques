   "en_pantalla": "Camión de mudanza; reloj 7:00",
   "cara": "(sin personaje)",
   "camara": "M"
  },
  {
   "n": 27,
   "inicio": 42.16,
   "fin": 43.64,
   "texto": "So I had one day left to say it.",
