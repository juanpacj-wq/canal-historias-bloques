   "fin": 88.24,
   "texto": "\"Just to see if you'd say it again on Wednesday.\"",
   "escenario": "Calle de noche",
   "en_pantalla": "Tess mira hacia abajo",
   "cara": "Ojos aguados",
   "camara": "C"
  },
  {
   "n": 58,
   "inicio": 88.24,
   "fin": 89.26,
   "texto": "It was Wednesday.",
   "escenario": "Calle de noche",
   "en_pantalla": "Reloj 12:02",
   "cara": "(sin personaje)",
   "camara": "C"
  },
  {
   "n": 59,
   "inicio": 89.26,
   "fin": 90.28,
   "texto": "She couldn't be lying.",
