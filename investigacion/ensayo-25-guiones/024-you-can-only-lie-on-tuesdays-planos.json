   "en_pantalla": "Narrador frente al espejo",
   "cara": "Decidido",
   "camara": "C"
  },
  {
   "n": 30,
   "inicio": 46.34,
   "fin": 48.76,
   "texto": "First I just said it. \"I like you. For real.\"",
